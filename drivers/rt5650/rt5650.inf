;/*++
;
;Module Name:
;    rt5650.inf
;
;Abstract:
;    INF file for installing the Realtek RT5650 codec driver (ASUS Chromebook CX15 "Telith")
;
;--*/

[Version]
Signature   = "$WINDOWS NT$"
Class       = Media
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/02/2026,0.1.0.0
CatalogFile = rt5650.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
rt5650.sys  = 1,,

[Manufacturer]
%StdMfg%=Standard,NTAMD64.10.0...16299

[Standard.NTAMD64.10.0...16299]
%rt5650.DeviceDesc%=Rt5650_Device, ACPI\10EC5650

[Rt5650_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
rt5650.sys

;-------------- Service installation
[Rt5650_Device.NT.Services]
AddService = rt5650,%SPSVCINST_ASSOCSERVICE%, Rt5650_Service_Inst

[Rt5650_Service_Inst]
DisplayName    = %rt5650.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\rt5650.sys

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderName           = "Telith Audio Project"
StdMfg                 = "Telith Audio Project"
DiskId1                = "RT5650 Installation Disk #1"
rt5650.DeviceDesc      = "Realtek RT5650 I2S Audio Codec"
rt5650.SVCDESC         = "RT5650 Service"
